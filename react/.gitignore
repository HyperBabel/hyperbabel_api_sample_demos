# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# local env files — keep filled-in values out of git.
# Commit `.env.example` (template); your own values go in `.env.local`.
.env
.env.production
.env.development
.env.local
.env.*.local
# Override parent sample_demos/.gitignore which excludes all .env.* — the
# template file MUST stay trackable so members can copy it.
!.env.example

# Defensive — secrets that should never be committed even if you scaffold
# a mobile flavour of this demo or wire signing certs into CI.
google-services.json
GoogleService-Info.plist
*.p8
*.p12
*.mobileprovision
