# HyperBabel Flutter Demo — Environment Variables
#
# Copy this file to .env only if you need to override defaults.
# .env is gitignored so your local values never leak.
#
# The demo works WITHOUT a .env on a fresh clone (sensible defaults
# apply). You really only need to populate this when running against a
# private HyperBabel deployment.
#
# After creating .env, ALSO add `- .env` under `flutter.assets:` in
# pubspec.yaml so flutter_dotenv can find it at runtime.

# ── HyperBabel API endpoint ────────────────────────────────────────────────
# Points at production by default — the right value for almost every
# integrator. Override only if you operate HyperBabel on a private domain.
HB_API_URL=https://api.hyperbabel.com/api/v1

# ── Note on Firebase ──────────────────────────────────────────────────────
# Flutter mobile apps don't read Firebase config from env vars — the
# native SDK reads everything from the two config files you drop into
# firebase/ (see firebase/README.md). There are no FIREBASE_* env vars
# in this template.
