{
  "expo": {
    "name": "HyperBabel Demo",
    "slug": "hyperbabel-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hyperbabel.demo",
      "infoPlist": {
        "NSCameraUsageDescription": "HyperBabel Demo uses the camera for video calls and live streaming.",
        "NSMicrophoneUsageDescription": "HyperBabel Demo uses the microphone for voice and video communication.",
        "NSPhotoLibraryUsageDescription": "HyperBabel Demo accesses your photo library for sending image messages.",
        "UIBackgroundModes": [
          "audio",
          "remote-notification",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "HyperBabel Demo can attach your current location to a chat message when you tap \"Use my location\". Coordinates are sent only when you confirm."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.hyperbabel.demo",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0a0a0f",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HyperBabel Demo uses the camera for video calls and live streaming."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "HyperBabel Demo uses the microphone for voice and video calls."
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.4",
            "buildReactNativeFromSource": true,
            "newArchEnabled": false
          },
          "android": {
            "newArchEnabled": false
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HyperBabel Demo can attach your current location to a chat message when you tap \"Use my location\"."
        }
      ]
    ],
    "scheme": "hyperbabel-demo",
    "extra": {
      "eas": {
        "projectId": "hyperbabel-demo"
      }
    }
  }
}
