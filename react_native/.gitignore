# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — keep filled-in values out of git.
# Commit `.env.example` (template); your own values go in `.env.local`.
.env
.env.local
.env.*.local
.env.development
.env.production
# Override parent sample_demos/.gitignore which excludes all .env.* — the
# template file MUST stay trackable so members can copy it.
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase native config — developer-supplied secrets, never commit
firebase/google-services.json
firebase/GoogleService-Info.plist
