# HyperBabel JavaScript Demo — Environment Variables
# Copy this file to .env and fill in your values.

# HyperBabel API base URL.
# Default points at the global production gateway; override for local dev.
VITE_HB_API_URL=https://api.hyperbabel.com/api/v1

# Your HyperBabel API Key. Get it from HyperBabel Console → Dashboard → API Keys.
VITE_HB_API_KEY=your_api_key_here
